<Window x:Class="wild_life_2.GameWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        mc:Ignorable="d"
        Title="GameWindow2"
        Width="800"
        Height="450"
        WindowState="Maximized"
        Background="LightGreen">

    <Grid Background="LightGreen">
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="GameCanvas"
                Width="800"
                Height="450"
                Background="LightGreen">


                <Image x:Name="Player"
                   Width="50"
                   Height="50"
                   Canvas.Left="100"
                   Canvas.Top="100"
                   Source="images/FemaleCharacter/Front_Idle.png"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>


                <!-- Houtbundel 1 -->
        <Image x:Name="Hout1"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="164"
       Canvas.Top="69"/>

        <!-- Houtbundel 2 -->
        <Image x:Name="Hout2"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="300"
       Canvas.Top="150"/>

        <!-- Houtbundel 3 -->
        <Image x:Name="Hout3"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="500"
       Canvas.Top="100"/>

        <!-- Houtbundel 4 -->
        <Image x:Name="Hout4"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="200"
       Canvas.Top="300"/>

        <!-- Houtbundel 5 -->
        <Image x:Name="Hout5"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="550"
       Canvas.Top="320"/>

        <!-- Houtteller -->
        <Border Canvas.Left="15"
        Canvas.Top="15"
        Canvas.ZIndex="20"
        Background="#FFFFF8E7"
        BorderBrush="#FF78A66A"
        BorderThickness="2"
        CornerRadius="12"
        Padding="12">

            <TextBlock x:Name="HoutTeller"
               Text="Hout: 0/5"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#FF426B3C"/>
        </Border>

        <!-- Het huis dat nog gebouwd moet worden -->
        <Image x:Name="Huis"
       Source="/Images/Cozy Pixel Art Cottage Sprite.png"
       Width="100"
       Height="100"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Opacity="0.4"
       Visibility="Collapsed"
       Canvas.Left="20"
       Canvas.Top="20"/>


            </Canvas>
        </Viewbox>

        <!-- POPUP: GENOEG HOUT VERZAMELD -->
        <Border x:Name="HoutPopup"
        Visibility="Collapsed"
        Background="#CC101820"
        Panel.ZIndex="250"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

            <Border Background="#FF243447"
            BorderBrush="#FF101820"
            BorderThickness="8"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Border Background="#FFFFDFA0"
                BorderBrush="#FF70A050"
                BorderThickness="4"
                Padding="20">

                    <StackPanel Width="360">

                        <TextBlock Text="JE HEBT GENOEG HOUT VERZAMELD"
                           FontFamily="Press Start 2P"
                           FontSize="14"
                           Foreground="#FF385B35"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                        <TextBlock Text="Ga naar het huis om het te bouwen."
                           FontFamily="Press Start 2P"
                           FontSize="11"
                           Foreground="#FF49351F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                        <Border Background="#FF426B3C"
                        BorderBrush="#FF263D24"
                        BorderThickness="4"
                        Padding="4">

                            <Button Content="VERDER"
                            FontFamily="Press Start 2P"
                            FontSize="10"
                            Foreground="White"
                            Background="#FF426B3C"
                            BorderThickness="0"
                            Padding="12"
                            Cursor="Hand"
                            Click="CloseHoutPopup"/>
                        </Border>

                    </StackPanel>
                </Border>
            </Border>
        </Border>


        
        <local:Inventory x:Name="InventoryPanel"
                     Visibility="Collapsed"
                     Panel.ZIndex="200"/>

       

        <Button x:Name="QuitButton"
        Content="QUIT"
        Width="66"
        Height="29"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,10,10,0"
        Panel.ZIndex="50"
        FontSize="10"
        FontFamily="Press Start 2P"
        Background="DarkRed"
        Foreground="White"
        Click="QuitButton_Click"/>
        
    </Grid>
</Window>