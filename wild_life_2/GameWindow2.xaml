<Window x:Class="wild_life_2.GameWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        mc:Ignorable="d"
        Title="GameWindow" Height="450" Width="800">
    <Canvas x:Name="GameCanvas" Background="LightGreen">

        <Image x:Name="Player"
         Source="/Images/FemaleCharacter/00_FemaleCharacter.png"
         Width="50"
         Height="50"
         Stretch="Uniform"
         Canvas.Left="100"
         Canvas.Top="100"
         RenderOptions.BitmapScalingMode="NearestNeighbor"/>


        <!-- Houtbundel 1 -->
        <Image x:Name="Hout1"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="164"
       Canvas.Top="69"/>

        <!-- Houtbundel 2 -->
        <Image x:Name="Hout2"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="300"
       Canvas.Top="150"/>

        <!-- Houtbundel 3 -->
        <Image x:Name="Hout3"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="500"
       Canvas.Top="100"/>

        <!-- Houtbundel 4 -->
        <Image x:Name="Hout4"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="200"
       Canvas.Top="300"/>

        <!-- Houtbundel 5 -->
        <Image x:Name="Hout5"
       Source="/Images/Basic biome/05_Basic Grass Biom things 1.png"
       Width="32"
       Height="32"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Canvas.Left="550"
       Canvas.Top="320"/>

        <!-- Houtteller -->
        <Border Canvas.Left="15"
        Canvas.Top="15"
        Canvas.ZIndex="20"
        Background="#FFFFF8E7"
        BorderBrush="#FF78A66A"
        BorderThickness="2"
        CornerRadius="12"
        Padding="12">

            <TextBlock x:Name="HoutTeller"
               Text="Hout: 0/5"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#FF426B3C"/>
        </Border>

        <!-- Het huis dat nog gebouwd moet worden -->
        <Image x:Name="Huis"
       Source="/Images/Cozy Pixel Art Cottage Sprite.png"
       Width="100"
       Height="100"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="NearestNeighbor"
       Opacity="0.4"
       Visibility="Collapsed"
       Canvas.Left="20"
       Canvas.Top="20"/>


    </Canvas>
</Window>
