<Window x:Class="wild_life_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Achtergrond  window -->
        <Image
        Source="/Images/WildLifeStartScherm2.png"
        Stretch="UniformToFill"
        RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <Viewbox Stretch="Uniform" StretchDirection="Both">

        <Grid Width="800" Height="450">


        <StackPanel
        Width="298"
        Height="195"
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
        Margin="0,205,0,0" >

            <Button
            Content="START"
            Height="40"
            Width="250"
            Margin="0,0,0,10"
            FontFamily="Press Start 2P"
            FontSize="18"
            Background="#D99A5B"
            Foreground="Black"
            BorderBrush="#59351F"
            BorderThickness="4"
            Click="StartButton_Click">


                <!-- Hover-effect -->
                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="Background" Value="#D99A5B"/>
                        <Setter Property="Foreground" Value="Black"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#F2C06B"/>
                                <Setter Property="Foreground" Value="#2F2418"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>
                </Button.Style>

            </Button>

            <Button
            Content="LOAD GAME"
            Height="40"
            Width="250"            
            Margin="0,0,0,10"
            FontFamily="Press Start 2P"
            FontSize="14"
            Background="#D99A5B"
            Foreground="Black"
            BorderBrush="#59351F"
            BorderThickness="4"/>

                    <Button
            Content="NEW GAME"
            Height="40"
            Width="250"            
            Margin="0,0,0,10"
            FontFamily="Press Start 2P"
            FontSize="14"
            Background="#D99A5B"
            Foreground="Black"
            BorderBrush="#59351F"
            BorderThickness="4"/>

                    <Button
            Content="INSTELLINGEN"
            Height="40"
            Width="250"
            FontFamily="Press Start 2P"
            FontSize="12"
            Background="#D99A5B"
            Foreground="Black"
            BorderBrush="#59351F"
            BorderThickness="4"/>

        </StackPanel>
    </Grid>
    </Viewbox>
    </Grid>
</Window>