<Window x:Class="wild_life_2.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        
        mc:Ignorable="d"
        Title="GameWindow" 
        Height="450" 
        Width="800"
        WindowState="Maximized">

    <Grid Background="LightGreen"
          ClipToBounds="True">


        <Border x:Name="ApplePopup"
        Visibility="Collapsed"
        Background="#CC101820"
        Panel.ZIndex="100"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

            <Border Background="#FF243447"
            BorderBrush="#FF101820"
            BorderThickness="8"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            SnapsToDevicePixels="True">

                <Border Background="#FFFFDFA0"
                BorderBrush="#FF70A050"
                BorderThickness="4"
                Padding="20">

                    <StackPanel Width="360">

                        <TextBlock Text="🍎 APPEL"
                           FontFamily="Press Start 2P"
                           FontSize="16"
                           Foreground="#FF385B35"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                        <TextBlock Text="Je hebt een appel gevonden!"
                           FontFamily="Press Start 2P"
                           FontSize="9"
                           Foreground="#FF49351F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>

                        <Border Background="#FF426B3C"
                        BorderBrush="#FF263D24"
                        BorderThickness="4"
                        Padding="4">

                            <Button Content="VERDER"
                            FontFamily="Press Start 2P"
                            FontSize="10"
                            Foreground="White"
                            Background="#FF426B3C"
                            BorderThickness="0"
                            Padding="12"
                            Cursor="Hand"
                            Click="CloseApplePopup"/>
                        </Border>

                    </StackPanel>
                </Border>
            </Border>
        </Border>



        <Viewbox Stretch="Uniform"
                >

            <Canvas x:Name="GameCanvas" 
                Width="800"
                Height="450"
                Background="LightGreen">


                <Border x:Name="InstructionBubble"
                Background="#FF486344"
                BorderBrush="#FF486344"
                BorderThickness="3"
                Padding="4"
                Width="340"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                SnapsToDevicePixels="True" Canvas.Top="354" Canvas.Left="8">

                    <Border Background="#FFFFDFA0"
                    BorderBrush="#FF70A050"
                    BorderThickness="3"
                    Padding="14">

                        <StackPanel>
                            <TextBlock Text="[ INSTRUCTIES ]"
                       FontFamily="Press Start 2P"
                       FontSize="10"
                       Foreground="#FF385B35"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="InstructionText"
                       Text="Gebruik de pijltjestoetsen om te bewegen."
                       FontFamily="Press Start 2P"
                       FontSize="7"
                       Foreground="#FF49351F"
                       TextWrapping="Wrap"
                       LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </Border>


                <Image x:Name="Player"
               Source="/Images/FemaleCharacter/Front_Idle.png"
               Width="50"
               Height="50"
               Stretch="Uniform"
               Canvas.Left="100"
               Canvas.Top="100"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>


                <Image x:Name="Vrucht"
               Source="/Images/red apple.png"
               Width="30"
               Height="30"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               Canvas.Left="600"
               Canvas.Top="100"/>

            </Canvas>
        </Viewbox>


        <!-- POPUP: GOED GEDAAN -->
        <Border x:Name="GoedGedaanPopup"
        Visibility="Collapsed"
        Background="#CC101820"
        Panel.ZIndex="250"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

            <Border Background="#FF243447"
            BorderBrush="#FF101820"
            BorderThickness="8"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Border Background="#FFFFDFA0"
                BorderBrush="#FF70A050"
                BorderThickness="4"
                Padding="30">

                    <StackPanel Width="360">

                        <TextBlock Text="GOED GEDAAN!"
                           FontFamily="Press Start 2P"
                           FontSize="22"
                           Foreground="#FF385B35"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,10"/>

                        <Border Background="#FF426B3C"
                        BorderBrush="#FF263D24"
                        BorderThickness="4"
                        Padding="4"
                        Margin="0,20,0,0">

                            <Button Content="VERDER"
                            FontFamily="Press Start 2P"
                            FontSize="10"
                            Foreground="White"
                            Background="#FF426B3C"
                            BorderThickness="0"
                            Padding="12"
                            Cursor="Hand"
                            Click="VerderButton_Click"/>
                        </Border>

                    </StackPanel>
                </Border>
            </Border>
        </Border>

        <local:Inventory x:Name="InventoryPanel"
                 Visibility="Collapsed"
                 Panel.ZIndex="200"/>

        <Button x:Name="QuitButton"
        Content="QUIT"
        Width="66"
        Height="29"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,10,10,0"
        Panel.ZIndex="50"
        FontSize="10"
        FontFamily="Press Start 2P"
        Background="DarkRed"
        Foreground="White"
        Click="QuitButton_Click"/>

    </Grid>
</Window>
