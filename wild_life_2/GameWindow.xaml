<Window x:Class="wild_life_2.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wild_life_2"
        mc:Ignorable="d"
        Title="GameWindow" Height="450" Width="800">
    <Canvas x:Name="GameCanvas" Background="LightGreen">

        <Border x:Name="InstructionBubble"
        Canvas.Left="15"
        Canvas.Bottom="15"
        Canvas.ZIndex="10"
        Width="280"
        Padding="14"
        Background="#FFFFF8E7"
        BorderBrush="#FF78A66A"
        BorderThickness="2"
        CornerRadius="18">

            <StackPanel>
                <TextBlock Text="🌿 WILD LIFE"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#FF426B3C"
                   Margin="0,0,0,8"/>

                <TextBlock x:Name="InstructionText"
                   Text="Welkom, avonturier! Loop naar de appel toe. Gebruik de pijltjestoetsen om te bewegen."
                   FontSize="14"
                   Foreground="#FF35452F"
                   TextWrapping="Wrap"/>
            </StackPanel>
        </Border>


        <Image x:Name="Player"
       Source="/Images/FemaleCharacter/00_FemaleCharacter.png"
       Width="50"
       Height="50"
       Stretch="Uniform"
       Canvas.Left="100"
       Canvas.Top="100"
       RenderOptions.BitmapScalingMode="NearestNeighbor"/>


        <Image x:Name="Vrucht"
              Source="/Images/Basic biome/02_Basic Grass Biom things 1.png"
              Width="30"
              Height="30"
              Stretch="Uniform"
              RenderOptions.BitmapScalingMode="NearestNeighbor"
              Canvas.Left="600"
              Canvas.Top="100"/>

    </Canvas>
</Window>
